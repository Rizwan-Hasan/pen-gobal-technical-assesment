generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

enum UserRole {
  STAFF
  STUDENT
}

model Programme {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  defaultFee   Decimal   @db.Decimal(10, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  students     Student[]
}

model Student {
  id            String          @id @default(cuid())
  studentId     String          @unique
  fullName      String
  email         String          @unique
  dateOfBirth   DateTime
  academicYear  String
  status        EnrolmentStatus @default(ENROLLED)
  feeAmount     Decimal         @db.Decimal(10, 2)
  feeDueDate    DateTime
  programmeId   String
  programme     Programme       @relation(fields: [programmeId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      Payment[]
  submissions   Submission[]
  results       Result[]
  users         User[]

  @@index([fullName])
  @@index([studentId])
  @@index([status])
  @@index([programmeId])
}

model Payment {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime
  reference String   @unique
  createdAt DateTime @default(now())

  @@index([studentId])
}

model Assessment {
  id          String       @id @default(cuid())
  title       String
  module      String
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  results     Result[]
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  mimeType     String
  submittedAt  DateTime   @default(now())
  isLate       Boolean    @default(false)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Result {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade        Int
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model User {
  id              String   @id @default(cuid())
  name            String
  role            UserRole
  linkedStudentId String?
  linkedStudent   Student? @relation(fields: [linkedStudentId], references: [id])
  createdAt       DateTime @default(now())
}
